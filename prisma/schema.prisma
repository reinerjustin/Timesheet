generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model TimeLog {
  id           Int      @id @default(autoincrement())
  workDate     DateTime @unique
  timeIn       String
  timeOut      String
  totalMinutes Int
  remarks      String?
  createdAt    DateTime @default(now())
}